  "tokenColors": [
    {
      "name": "Comments",
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#897895",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comments",
      "scope": "comment.block.documentation, storage.type.class.jsdoc",
      "settings": {
        "foreground": "#A58DAC",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": "keyword, keyword.control, storage.type, storage.modifier",
      "settings": {
        "foreground": "#B18AFF"
      }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator, punctuation.accessor, punctuation.separator.key-value",
      "settings": {
        "foreground": "#E96BBE"
      }
    },
    {
      "name": "Declarations",
      "scope": "keyword.declaration, storage.type.function, storage.type.class",
      "settings": {
        "foreground": "#B18AFF"
      }
    },
    {
      "name": "Strings",
      "scope": "string, string.quoted, string.template",
      "settings": {
        "foreground": "#FFC39F"
      }
    },
    {
      "name": "String escapes",
      "scope": "constant.character.escape, constant.other.placeholder",
      "settings": {
        "foreground": "#FF59CB"
      }
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric, constant.language.boolean, constant.language.null, constant.language.undefined",
      "settings": {
        "foreground": "#FFE28A"
      }
    },
    {
      "name": "Constants",
      "scope": "constant.language, constant.other, support.constant",
      "settings": {
        "foreground": "#FFE28A"
      }
    },
    {
      "name": "Functions",
      "scope": "entity.name.function, support.function, meta.function-call entity.name.function, variable.function",
      "settings": {
        "foreground": "#75CEDF"
      }
    },
    {
      "name": "Methods",
      "scope": "entity.name.function.member, support.function.builtin",
      "settings": {
        "foreground": "#75CEDF"
      }
    },
    {
      "name": "Classes and types",
      "scope": "entity.name.type, entity.name.class, support.class, support.type, storage.type.annotation",
      "settings": {
        "foreground": "#B6FF9A"
      }
    },
    {
      "name": "Interfaces and structs",
      "scope": "entity.name.type.interface, entity.name.type.struct, entity.name.type.enum",
      "settings": {
        "foreground": "#B6FF9A"
      }
    },
    {
      "name": "Parameters",
      "scope": "variable.parameter, meta.function.parameters variable",
      "settings": {
        "foreground": "#FFC39F"
      }
    },
    {
      "name": "Variables",
      "scope": "variable, meta.definition.variable",
      "settings": {
        "foreground": "#F5EDFF"
      }
    },
    {
      "name": "Properties",
      "scope": "variable.other.property, support.variable.property, meta.object-literal.key",
      "settings": {
        "foreground": "#79AFFF"
      }
    },
    {
      "name": "Built-ins",
      "scope": "support.variable, variable.language, support.module",
      "settings": {
        "foreground": "#E96BBE"
      }
    },
    {
      "name": "Namespaces",
      "scope": "entity.name.namespace, entity.name.module",
      "settings": {
        "foreground": "#B6FF9A"
      }
    },
    {
      "name": "Tags",
      "scope": "entity.name.tag, meta.tag.sgml entity.name.tag",
      "settings": {
        "foreground": "#FF59CB"
      }
    },
    {
      "name": "Attributes",
      "scope": "entity.other.attribute-name, meta.attribute",
      "settings": {
        "foreground": "#B18AFF"
      }
    },
    {
      "name": "HTML text",
      "scope": "text.html, text.xml",
      "settings": {
        "foreground": "#F5EDFF"
      }
    },
    {
      "name": "CSS selectors",
      "scope": "entity.other.attribute-name.class.css, entity.other.attribute-name.id.css, entity.name.tag.css",
      "settings": {
        "foreground": "#FF59CB"
      }
    },
    {
      "name": "CSS properties",
      "scope": "support.type.property-name.css, meta.property-name.css",
      "settings": {
        "foreground": "#7DEBFF"
      }
    },
    {
      "name": "CSS values",
      "scope": "support.constant.property-value.css, support.constant.color.w3c-standard-color-name.css",
      "settings": {
        "foreground": "#FFC39F"
      }
    },
    {
      "name": "JSON keys",
      "scope": "support.type.property-name.json, meta.structure.dictionary.key.json string.quoted.double.json",
      "settings": {
        "foreground": "#7DEBFF"
      }
    },
    {
      "name": "JSON values",
      "scope": "meta.structure.dictionary.value.json string.quoted",
      "settings": {
        "foreground": "#FFC39F"
      }
    },
    {
      "name": "YAML keys",
      "scope": "entity.name.tag.yaml, meta.mapping.key.yaml",
      "settings": {
        "foreground": "#7DEBFF"
      }
    },
    {
      "name": "Markdown headings",
      "scope": "markup.heading, entity.name.section.markdown",
      "settings": {
        "foreground": "#FF59CB",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "settings": {
        "foreground": "#FFE28A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "settings": {
        "foreground": "#FFC39F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown links",
      "scope": "markup.underline.link, string.other.link",
      "settings": {
        "foreground": "#7DEBFF",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown code",
      "scope": "markup.inline.raw, markup.fenced_code",
      "settings": {
        "foreground": "#B6FF9A"
      }
    },
    {
      "name": "Diff added",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#B6FF9A"
      }
    },
    {
      "name": "Diff removed",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#FF7996"
      }
    },
    {
      "name": "Diff changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#FFE28A"
      }
    },
    {
      "name": "Invalid syntax",
      "scope": "invalid, invalid.illegal",
      "settings": {
        "foreground": "#FF7996",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Regex",
      "scope": "string.regexp",
      "settings": {
        "foreground": "#B6FF9A"
      }
    },
    {
      "name": "Decorators",
      "scope": "meta.decorator, entity.name.function.decorator",
      "settings": {
        "foreground": "#FF59CB"
      }
    },
    {
      "name": "Punctuation",
      "scope": "punctuation, meta.brace, meta.delimiter",
      "settings": {
        "foreground": "#BDAACD"
      }
    },
    {
      "name": "CSS file selectors",
      "scope": "source.css entity.other.attribute-name.class.css, source.css entity.other.attribute-name.id.css, source.css entity.name.tag.css, source.css entity.other.pseudo-class.css, source.css entity.other.pseudo-element.css",
      "settings": {
        "foreground": "#FF59CB"
      }
    },
    {
      "name": "CSS file property names",
      "scope": "source.css support.type.property-name.css, source.css meta.property-name.css",
      "settings": {
        "foreground": "#B9ACC9"
      }
    },
    {
      "name": "CSS file property values",
      "scope": "source.css meta.property-value.css",
      "settings": {
        "foreground": "#D7CADF"
      }
    },
    {
      "name": "CSS file keywords",
